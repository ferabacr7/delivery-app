{
  "expo": {
    "name": "ORBIT",
    "slug": "DeliveryApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/stores/app-icon.png",
    "scheme": "deliveryapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/stores/app-icon.png",
      "bundleIdentifier": "com.orbitcr.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.orbitcr.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/stores/android-foreground.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/stores/splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ORBIT utiliza tu ubicación para guardar direcciones, calcular rutas y permitir el seguimiento de entregas activas."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ce1ce5e-5358-48d2-8c68-3b62227133df"
      }
    },
    "owner": "ferabacr7"
  }
}
